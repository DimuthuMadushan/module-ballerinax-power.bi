public type GetDatasetsInGroupAsAdminQueries record {
    # Skips the first n results
    @http:Query {name: "$skip"}
    int:Signed32 skip?;
    # Returns only the first n results
    @http:Query {name: "$top"}
    int:Signed32 top?;
    # Returns a subset of a results based on [Odata](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part2-url-conventions.html#sec_SystemQueryOptions) filter query parameter condition
