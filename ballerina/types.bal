    # datesFormatString
    string datesFormatString?;
    # The goal permissions
    "None"|"View"|"UpdateCurrentValue"|"UpdateTargetValue"|"UpdateNotes"|"UpdateStatus"|"UpdateValues"|"All"|"11"|"13"|"15"|"19"|"21"|"23"|"25"|"27"|"29" permissions?;
    # The goal name
    string name?;
    # The UTC time at creation
    string createdTime?;
    # The rank of the goal within the ordered set of sibling goals
    int rank?;
    # The UTC timestamp for the completion date of the goal. The time portion of the timestamp is zero
    string completionDate?;
    # The goal ID
    string id?;
    # The scorecard ID
    string scorecardId?;
    # The list of aggregated properties of the goal
